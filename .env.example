# Judicia Mobile Environment Configuration
# ========================================
#
# MODE 1 (DEFAULT / RECOMMENDED): Automatic Local Wi-Fi Detection
# Leave EXPO_PUBLIC_API_URL empty or commented out.
# Expo automatically detects your host computer's IP address and points to:
# http://<YOUR_PC_IP>:3000/api
# No configuration is needed as long as your phone and PC are on the same Wi-Fi network!
#
# EXPO_PUBLIC_API_URL=

# MODE 2: Staging Server or Cloudflare / ngrok Tunnel
# If you are testing across the internet or your Wi-Fi network isolates devices (campus/office Wi-Fi),
# uncomment and provide your tunnel / backend URL below:
# EXPO_PUBLIC_API_URL=https://your-staging-api.com/api

